{
  "preset": "@amazon-devices/react-native-kepler",
  "testRegex": "/test/.*\\.(test|spec)\\.(ts|tsx|js)$",
  "setupFiles": [
    "<rootDir>/test/setup.js"
  ],
  "moduleFileExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "json",
    "node"
  ],
  "moduleNameMapper": {
    "^react-native$": "@amazon-devices/react-native-kepler",
    "^react-native/(.*)$": "@amazon-devices/react-native-kepler/$1",
    "^~/(.*)$": "<rootDir>/src/$1",
    "^@amazon-devices/react-native-w3cmedia$": "<rootDir>/test/mocks/w3cmedia.js"
  },
  "modulePaths": [
    "<rootDir>/src"
  ],
  "roots": [
    "<rootDir>/src/",
    "<rootDir>/test/",
    "<rootDir>/node_modules/"
  ],
  "transformIgnorePatterns": [
    "node_modules/(?!(react-native|@react-native|@amazon-devices/react-native-kepler|@amazon-devices)/)"
  ],
  "testTimeout": 15000,
  "collectCoverage": false,
  "collectCoverageFrom": [
    "src/**/*",
    "!**/index.{ts,js,tsx}",
    "!**/types.ts",
    "!src/**/*.d.ts"
  ],
  "coverageDirectory": ".tmp/coverage"
}
